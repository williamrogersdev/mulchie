{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulchie-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates the DNS record and certificate for a custom domain. The zone
  // must be in the account the Worker is deployed to.
  "routes": [{ "pattern": "mulchie.com", "custom_domain": true }]
}
