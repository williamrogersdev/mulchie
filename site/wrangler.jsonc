{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulchie-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // The custom domain mulchie.com is attached in the Cloudflare dashboard (or by
  // adding a `routes` entry with `custom_domain: true`) once DNS is ready.
}
