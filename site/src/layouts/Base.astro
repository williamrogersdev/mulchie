---
import '../styles/tokens.css';
import '../styles/site.css';
import { SITE, REPO } from '../lib/meta';
import mark from '../assets/mark.png';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: object;
  current?: 'install' | 'docs' | '';
  noindex?: boolean;
}
const { title, description, ogImage = 'home', jsonLd, current = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const image = `${SITE}/og/${ogImage}.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101410" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mulchie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="Mulchie home">
          <img src={mark.src} width="28" height="28" alt="" />
          <span>Mulchie</span>
        </a>
        <nav aria-label="Primary">
          <a href="/install/" aria-current={current === 'install' ? 'page' : undefined}>Install</a>
          <a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p>Mulchie is open source under the MIT license.</p>
        <nav aria-label="Footer">
          <a href="/install/">Install</a>
          <a href="/docs/">Docs</a>
          <a href={REPO}>Source</a>
          <a href={`${REPO}/releases`}>Releases</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
