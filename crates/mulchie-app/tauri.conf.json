{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mulchie",
  "identifier": "dev.mulchie.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html#panel",
        "title": "Mulchie",
        "width": 400,
        "height": 620,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "dashboard",
        "url": "index.html#dashboard",
        "title": "Mulchie",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "focus": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Keeps machines running many AI agents healthy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/mulchie"
    ]
  }
}
