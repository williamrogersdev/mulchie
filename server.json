{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.williamrogersdev/mulchie",
  "title": "Mulchie",
  "description": "See what is slowing a machine shared by AI agents, and reclaim space safely, plan first.",
  "version": "0.3.0-rc.1",
  "websiteUrl": "https://mulchie.com",
  "repository": {
    "url": "https://github.com/williamrogersdev/mulchie",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "mulchie",
      "version": "0.3.0-rc.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "MULCHIE_MCP_READ_ONLY",
          "description": "Set to 1 to offer only tools that change nothing (plus build slots).",
          "isRequired": false,
          "format": "boolean"
        }
      ]
    }
  ]
}
